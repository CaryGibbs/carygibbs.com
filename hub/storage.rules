rules_version = '2';
// ============================================================
// LOBE LIMPET: Storage security rules (question images)
// Signed-in users can view. Admins can upload to any pack; parents and
// teachers can upload to their own packs (made in My packs). Images only,
// under 5 MB.
// Paste into Firebase console > Storage > Rules, then Publish.
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {
    function ownerUid() { return '0hFoAiW9YFhqk2BovndPnoT1Ul22'; }
    function isAdmin() {
      let d = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return request.auth.uid == ownerUid() || 'admin' in d.get('roles', []) || d.get('role', '') == 'admin';
    }

    function ownsPack(packId) {
      return firestore.get(/databases/(default)/documents/content/$(packId)).data.get('ownerUid', '') == request.auth.uid;
    }

    match /content/{packId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || ownsPack(packId))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (isAdmin() || ownsPack(packId));
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
