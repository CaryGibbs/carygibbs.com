rules_version = '2';
// ============================================================
// LOBE LIMPET: Storage security rules (question images)
// Signed-in users can view; only the owner or an admin can upload.
// Paste into Firebase console > Storage > Rules, then Publish.
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {
    function ownerUid() { return '0hFoAiW9YFhqk2BovndPnoT1Ul22'; }
    function isAdmin() {
      let d = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return request.auth.uid == ownerUid() || 'admin' in d.get('roles', []) || d.get('role', '') == 'admin';
    }

    match /content/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
